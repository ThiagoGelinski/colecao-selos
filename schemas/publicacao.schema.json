{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pacote de preparação de publicação — v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "base_commit",
    "created_at",
    "records",
    "ids",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "repository": {
      "const": "ThiagoGelinski/colecao-selos"
    },
    "base_commit": {
      "$ref": "#/$defs/gitSha"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "base_sha256",
          "blob_etag",
          "record",
          "assets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SEL-[0-9]{6}$"
          },
          "base_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/hash"
              },
              {
                "type": "null"
              }
            ]
          },
          "blob_etag": {
            "type": "string",
            "minLength": 1
          },
          "record": {
            "type": "object"
          },
          "assets": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/asset"
            }
          }
        }
      }
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_sha256",
        "blob_etag",
        "value"
      ],
      "properties": {
        "base_sha256": {
          "$ref": "#/$defs/hash"
        },
        "blob_etag": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "object",
          "required": [
            "next_sequence",
            "reserved"
          ],
          "properties": {
            "next_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "reserved": {
              "type": "array",
              "maxItems": 999999,
              "items": {
                "type": "object",
                "required": [
                  "sequence"
                ],
                "properties": {
                  "sequence": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 999999
                  }
                }
              }
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "decided_at",
        "snapshot_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "decided_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "file",
        "sha256",
        "original",
        "transform"
      ],
      "properties": {
        "role": {
          "enum": [
            "frente",
            "verso",
            "card",
            "thumb"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "original": {
          "$ref": "#/$defs/file"
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "source_width",
            "source_height",
            "crop",
            "encoder"
          ],
          "properties": {
            "format": {
              "const": "webp"
            },
            "source_width": {
              "type": "integer",
              "minimum": 1
            },
            "source_height": {
              "type": "integer",
              "minimum": 1
            },
            "crop": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "left",
                "right",
                "top",
                "bottom"
              ],
              "properties": {
                "left": {
                  "type": "integer",
                  "minimum": 0
                },
                "right": {
                  "type": "integer",
                  "minimum": 0
                },
                "top": {
                  "type": "integer",
                  "minimum": 0
                },
                "bottom": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "encoder": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "lossless",
                "quality"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "lossless": {
                  "type": "boolean"
                },
                "quality": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      }
    }
  }
}
