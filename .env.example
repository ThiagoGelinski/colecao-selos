PUBLICATION_MODE=preview
SITE_URL=https://colecaodeselos.netlify.app

# Administração — use somente placeholders; configure os segredos reais no ambiente server-side.
ADMIN_SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
ADMIN_ROLE=administrador
ADMIN_SESSION_TTL_SECONDS=28800

# Habilite temporariamente apenas para a ativação inicial em produção/local autorizado.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
# Publicação: segredo somente no servidor, escopo Functions no Netlify.
# Restrinja ao repositório ThiagoGelinski/colecao-selos; consulte docs/publicacao/arquitetura.md.
# Vazio desabilita a integração; nunca versione ou exponha um token real.
GITHUB_PUBLISH_TOKEN=

# Área administrativa da recuperação; não move nem apaga o store legado.
# Seletor aplicado somente à persistência serverless do catálogo, separado das credenciais.
CATALOG_BLOB_STORE=colecao-selos-catalogo-v2
