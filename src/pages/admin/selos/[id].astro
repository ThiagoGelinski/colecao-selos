---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
const id = Astro.params.id ?? '';
---
<AdminLayout title={`Registro ${id}`}>
  <header class="page-head"><div><p class="eyebrow">Consulta e gestão de assets</p><h1>{id}</h1></div><a class="button" href="/admin/selos">Voltar à lista</a></header>
  <section data-detail data-record-id={id}><div class="panel loading">Carregando registro…</div></section>
  <script>
    const target = document.querySelector<HTMLElement>('[data-detail]')!; const id = target.dataset.recordId ?? '';
    const entities: Record<string, string> = { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }; const escape = (value: unknown) => String(value ?? '—').replace(/[&<>"']/g, (char) => entities[char] ?? char);
    fetch(`/api/admin/selos/${encodeURIComponent(id)}`).then(async (response) => {
      const payload = await response.json(); if (response.status === 401) { window.dispatchEvent(new Event('admin:session-expired')); return; } if (!response.ok) throw new Error(payload.error?.message);
      const item = payload.data.resumo; const history = payload.data.historico.length ? `<ul>${payload.data.historico.map((event: { tipo: string; ocorrido_em: string }) => `<li>${escape(event.tipo)} — ${escape(event.ocorrido_em)}</li>`).join('')}</ul>` : '<p class="muted">Registro legado sem eventos editoriais.</p>';
      const validationLayers = [['Estrutural', item.validacao.estrutural], ['Semântica', item.validacao.semantica], ['Editorial', item.validacao.editorial], ['Assets', item.validacao.assets]];
      const validation = validationLayers.map(([label, layer]) => `<article class="panel detail-card"><h3>${label}</h3><span class="badge ${layer.estado === 'valida' ? 'ok' : 'bad'}">${escape(layer.rotulo)}${layer.estado === 'invalida' ? ` — ${escape(layer.erros)} erro(s)` : ''}</span></article>`).join('');
      const assetsBlock = ['frente', 'card', 'verso', 'thumb'].map((kind) => {
        const estado = item.imagens[kind];
        const isRequired = kind === 'frente' || kind === 'card';
        const labelText = isRequired ? `${escape(kind)} (Obrigatório)` : `${escape(kind)} (Opcional)`;

        let visual = '';
        if (estado.valido) {
            const path = payload.data.registro.imagens?.[kind];
            visual = `
                <div class="asset-preview" style="margin-bottom:12px;">
                    <img src="${escape(path)}" alt="Preview ${escape(kind)}" style="max-width:200px; display:block; margin: 10px 0; border: 1px solid #ddd;" />
                    <p class="muted">Path: <code>${escape(path)}</code></p>
                    <span class="badge ok">Processado</span>
                </div>
                <form class="asset-upload-form" data-kind="${escape(kind)}" data-id="${escape(id)}" data-method="PUT">
                    <input type="hidden" name="expected_updated_at" value="${escape(payload.data.registro.auditoria?.ultima_revisao)}" />
                    <div style="margin-bottom: 8px; border-top: 1px dashed #eee; padding-top: 8px;">
                        <label for="replace-file-${escape(kind)}" style="display:block; font-weight:bold; margin-bottom: 4px;">Substituir imagem (.webp)</label>
                        <input type="file" id="replace-file-${escape(kind)}" accept="image/webp" required />
                    </div>
                    <div class="feedback-msg" style="margin-bottom: 8px; color: #cc0000;"></div>
                    <button type="submit" class="button">Substituir</button>
                </form>
            `;
        } else {
            visual = `
                <form class="asset-upload-form" data-kind="${escape(kind)}" data-id="${escape(id)}" data-method="POST">
                    <div style="margin-bottom: 8px;">
                        <label for="file-${escape(kind)}" style="display:block; font-weight:bold; margin-bottom: 4px;">Arquivo (.webp)</label>
                        <input type="file" id="file-${escape(kind)}" accept="image/webp" required ${isRequired ? 'aria-required="true"' : ''} />
                    </div>
                    <div class="feedback-msg" style="margin-bottom: 8px; color: #cc0000;"></div>
                    <button type="submit" class="button">Fazer Upload</button>
                </form>
            `;
        }
        return `<li style="margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px dashed #eee;"><strong>${labelText}</strong><br>${visual}</li>`;
      }).join('');

      target.innerHTML = `<div class="detail-grid"><dl class="panel detail-card"><dt>Título</dt><dd>${escape(item.titulo)}</dd><dt>País / ano</dt><dd>${escape(item.pais)} · ${escape(item.ano)}</dd><dt>Status</dt><dd>${escape(item.status)}</dd><dt>Resultado geral</dt><dd><span class="badge ${item.validacao.valida ? 'ok' : 'bad'}">${item.validacao.valida ? 'Válido' : `${escape(item.validacao.erros)} erro(s)`}</span></dd><dt>Página pública</dt><dd><a href="/selos/${encodeURIComponent(item.slug)}">Abrir página</a></dd></dl><div class="panel detail-card"><h2>Histórico editorial</h2>${history}</div></div><h2 class="section-title">Camadas de validação</h2><div class="validation-grid">${validation}</div><section class="panel detail-card"><h2>Imagens do selo</h2><ul style="list-style: none; padding: 0;">${assetsBlock}</ul></section><h2 class="section-title">Registro oficial</h2><pre class="record-json">${escape(JSON.stringify(payload.data.registro, null, 2))}</pre>`;

      target.querySelectorAll('.asset-upload-form').forEach(form => {
          form.addEventListener('submit', async (e) => {
              e.preventDefault();
              const f = e.target as HTMLFormElement;
              const kind = f.dataset.kind!;
              const httpMethod = f.dataset.method || 'POST';
              const btn = f.querySelector('button') as HTMLButtonElement;
              const msg = f.querySelector('.feedback-msg') as HTMLElement;
              const input = f.querySelector('input[type="file"]') as HTMLInputElement;

              if (!input.files || input.files.length === 0 || !input.files[0]) return;

              btn.disabled = true;
              btn.textContent = 'Enviando...';
              msg.textContent = '';
              msg.style.color = '#cc0000';

              const formData = new FormData();
              formData.append('papel', kind);
              formData.append('file', input.files[0]);

              if (httpMethod === 'PUT') {
                  const expectedField = f.querySelector('input[name="expected_updated_at"]') as HTMLInputElement;
                  if (expectedField) formData.append('expected_updated_at', expectedField.value);
              }

              try {
                  const res = await fetch(`/api/admin/selos/${encodeURIComponent(f.dataset.id!)}/assets`, {
                      method: httpMethod,
                      body: formData
                  });
                  const json = await res.json();

                  if (res.ok) {
                      msg.style.color = 'green';
                      msg.textContent = httpMethod === 'PUT' ? 'Retificação concluída com sucesso. Recarregando...' : 'Upload concluído com sucesso. Recarregando...';
                      setTimeout(() => window.location.reload(), 1000);
                  } else {
                      let text = json.error?.message || 'Falha no servidor';
                      if (res.status === 400) text = `Requisição inválida: ${text}`;
                      if (res.status === 401) { text = 'Sessão expirada'; window.dispatchEvent(new Event('admin:session-expired')); }
                      if (res.status === 404) text = 'Selo/Asset não encontrado';
                      if (res.status === 409) text = httpMethod === 'PUT' ? 'Bloqueio otimista: estado do registro divergiu (mid-air collision).' : 'Asset já existe';
                      if (res.status === 413) text = 'Arquivo excede limite permitido (5MB)';
                      if (res.status === 415) text = `Formato inválido: ${text}`;
                      if (res.status === 422) text = `Dados inválidos: ${text}`;
                      if (res.status === 500) text = 'Falha interna no servidor';
                      msg.textContent = text;
                      btn.disabled = false;
                      btn.textContent = httpMethod === 'PUT' ? 'Substituir' : 'Fazer Upload';
                      input.value = ''; // clean field
                  }
              } catch (err: any) {
                  msg.textContent = err.message || 'Erro de rede';
                  btn.disabled = false;
                  btn.textContent = 'Fazer Upload';
              }
          });
      });

    }).catch((error) => { target.innerHTML = `<div class="error">${escape(error.message || 'Erro ao carregar registro.')}</div>`; });
  </script>
</AdminLayout>
