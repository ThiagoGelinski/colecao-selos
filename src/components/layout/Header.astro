---
import Container from './Container.astro';
import { isPreviewMode } from '../../lib/config';

const path = Astro.url.pathname;
const links = [{ href: '/', label: 'Início' }, { href: '/catalogo', label: 'Catálogo' }, { href: '/sobre', label: 'Sobre' }];
---
{isPreviewMode && <div class="preview">Ambiente de homologação</div>}
<header>
  <Container>
    <nav aria-label="Navegação principal">
      <a class="brand" href="/" aria-label="Coleção Selos — início"><span aria-hidden="true">CS</span> Coleção Selos</a>
      <ul>
        {links.map(({ href, label }) => <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>)}
      </ul>
      <a class="admin-cta" href="/admin/login?returnTo=/admin" data-admin-cta>Área do Administrador</a>
      <form class="admin-status" data-admin-status method="post" action="/api/admin/auth/logout" hidden>
        <button type="button" data-admin-logout>Sair</button>
      </form>
    </nav>
  </Container>
</header>
<script>
  async function mountAdminSession() {
    try {
      const response = await fetch('/api/admin/auth/session', { credentials: 'same-origin', cache: 'no-store' });
      if (!response.ok) return;
      const payload = await response.json();
      if (!payload?.ok || !payload?.data?.user) return;
      document.querySelectorAll<HTMLAnchorElement>('[data-admin-cta]').forEach(link => {
        link.textContent = 'Painel administrativo';
        link.href = '/admin';
      });
      document.querySelectorAll<HTMLFormElement>('[data-admin-status]').forEach(form => {
        form.hidden = false;
        form.querySelector<HTMLButtonElement>('[data-admin-logout]')?.addEventListener('click', async event => {
          const button = event.currentTarget as HTMLButtonElement;
          button.disabled = true;
          try {
            const result = await fetch('/api/admin/auth/logout', { method: 'POST', credentials: 'same-origin' });
            if (!result.ok) throw new Error('Falha ao encerrar a sessão.');
            window.location.assign('/admin/login');
          } catch {
            button.textContent = 'Tentar sair novamente';
            button.disabled = false;
          }
        });
      });
    } catch { /* O acesso ao login permanece disponível. */ }
  }
  void mountAdminSession();
</script>
<style>
.preview{padding:.32rem 1rem;background:var(--color-info);color:white;text-align:center;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
header{border-bottom:1px solid var(--color-border);background:rgb(244 240 232/.94)}
nav{flex-wrap:wrap;min-height:4.6rem;display:flex;align-items:center;justify-content:space-between;gap:1rem}
.brand{display:flex;align-items:center;gap:.65rem;font-family:var(--serif);font-size:1.15rem;text-decoration:none}
.brand span{display:grid;place-items:center;width:2.2rem;aspect-ratio:1;background:var(--color-accent-dark);color:white;font:700 .72rem var(--sans);letter-spacing:.08em}
ul{display:flex;gap:clamp(.65rem,3vw,1.8rem);margin:0;padding:0;list-style:none}
nav li a{color:var(--color-text);text-decoration:none}nav li a[aria-current='page']{text-decoration:underline;text-decoration-thickness:2px}
.admin-cta{display:inline-flex;align-items:center;padding:.45rem .75rem;border:1px solid var(--color-accent);border-radius:999rem;color:var(--color-accent);text-decoration:none;font-size:.8rem;font-weight:700;white-space:nowrap}
.admin-cta:hover{background:var(--color-accent);color:white}
.admin-status{margin-left:auto}
.admin-status button{border:0;border-radius:.45rem;padding:.45rem .7rem;background:var(--color-accent);color:white;font:inherit;font-weight:700;cursor:pointer}
.admin-status button:focus-visible,.admin-cta:focus-visible{outline:2px solid currentColor;outline-offset:2px}
[hidden]{display:none!important}
@media(max-width:40rem){nav{padding-block:.75rem;gap:.6rem}ul{flex:1;justify-content:flex-end}.admin-cta{margin-left:auto}}
@media(max-width:28rem){
  .brand{font-size:0}
  .brand span{font-size:.72rem}
}
</style>
