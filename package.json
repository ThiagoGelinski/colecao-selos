{
  "name": "colecao-selos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test --test-isolation=process tests/*.test.mjs",
    "lint": "astro check",
    "typecheck": "astro check",
    "publicacao:preparar": "node tools/publicacao.mjs",
    "test:schema": "node --test tests/schema.test.mjs",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "preview": "astro preview",
    "selo:novo": "node tools/catalogo.mjs selo:novo",
    "selo:preparar": "node tools/catalogo.mjs selo:preparar",
    "selo:validar": "node tools/catalogo.mjs selo:validar",
    "selo:revisao": "node tools/catalogo.mjs selo:revisao",
    "selo:aprovar": "node tools/catalogo.mjs selo:aprovar",
    "selo:rejeitar": "node tools/catalogo.mjs selo:rejeitar",
    "selo:revogar": "node tools/catalogo.mjs selo:revogar",
    "selo:status": "node tools/catalogo.mjs selo:status",
    "selo:publicar": "node tools/catalogo.mjs selo:publicar",
    "selo:auditoria": "node tools/catalogo.mjs selo:auditoria",
    "catalogo:auditoria": "node tools/catalogo.mjs catalogo:auditoria",
    "catalogo:status": "node tools/catalogo.mjs catalogo:status",
    "catalogo:manutencao": "node tools/catalogo.mjs catalogo:manutencao",
    "ci": "npm test && npm run catalogo:auditoria && npm audit --audit-level=high && npm run lint && npm run typecheck && npm run build && node tests/netlify-bundle.check.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.5",
    "@astrojs/sitemap": "^3.5.1",
    "@netlify/blobs": "10.7.13",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "7.3.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@netlify/vite-plugin": "3.0.1",
    "sharp": "$sharp"
  }
}
